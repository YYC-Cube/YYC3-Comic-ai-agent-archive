# YYC³ Agent Archive 环境变量模板（密钥零入库：真实 .env 不入仓）
# 消费方：components/（编排引擎 / DramaToolGateway / BaseAgent）

# ── LLM 统一入口（BaseAgent；OpenAI 兼容网关或本地 Ollama）──
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama-local
# LLM_MODEL=yyc3-family-coder:14b-q4
# LLM_TIMEOUT=60            # 单请求超时（秒），挂死防线
# LLM_MAX_TOKENS=512        # 生成预算上限，思考模式长生成防线
# LLM_TEMPERATURE=0.3

# ── ComfyUI 文生图（DramaToolGateway.text_to_image · M3 视听产能）──
# COMFYUI_URL=http://localhost:8188
# COMFYUI_MODEL=sd_xl_base_1.0.safetensors
# COMFYUI_TIMEOUT=300
# COMFYUI_POLL_INTERVAL=1.0
# COMFY_ALLOWED_HOSTS=localhost,127.0.0.1,::1   # SSRF 白名单（内网主机显式放行）

# ── H3 图生视频（DramaToolGateway.image_to_video，跨仓对接）──
# H3_AGENT_GATEWAY=
# AGENT_CLAIM_SECRET=       # 发放自 H3 仓 .secrets/agent_claim.env，勿入库
# H3_CLAIM_TTL=300
# H3_GATEWAY_TIMEOUT=30
# H3_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# ── RAG / A2A（Milvus 与 Redis 部署后启用）──
# MILVUS_HOST=10.0.0.11
# MILVUS_PORT=19530
# DGX1_EMBED_URL=http://10.0.0.11:8001/v1
# DGX1_EMBED_API_KEY=
# REDIS_HOST=localhost
# REDIS_PORT=6379
